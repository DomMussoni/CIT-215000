<!DOCTYPE html>
<html>

<head>

  <title>Mini Calculator</title>

</head>

<body>

<script>

let number1 = prompt("Please enter a Num:");

if (!isNaN(number1)) {

    let operator = prompt("Enter an operator (Examples: +, -, *, /):");

    if (operator == "+" || operator == "-" || operator == "*" || operator == "/") {

        let number2 = prompt("Please enter a second Num:");

        if (!isNaN(number2)) {

            number1 = Number(number1);

            number2 = Number(number2);

            let result;

            if (operator == "+") {

                result = number1 + number2;

            } else if (operator == "-") {

                result = number1 - number2;

            } else if (operator == "*") {

                result = number1 * number2;

            } else if (operator == "/") {

                result = number1 / number2;

            }

            alert("The answer is " + result);

        } else {

            alert("That is not a valid or real Num. I will now be closing the program.");

        }

    } else {

        alert("YOU ARE NOT A VALID OPERATOR. Exiting program.");

    }

} else {

    alert("That is not a valid or real Num. I will now be closing the program.");

}
</script>

</body>

</html>
